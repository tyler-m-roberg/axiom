# ----- Postgres -----
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom
POSTGRES_DB=axiom
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Keycloak -----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=axiom
KEYCLOAK_CLIENT_ID=axiom-bff
KEYCLOAK_CLIENT_SECRET=axiom-bff-secret-change-me

# ----- API / BFF -----
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173

# 32-byte base64 key used to encrypt OIDC tokens at rest.
# Generate locally with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SESSION_ENCRYPTION_KEY=9mkDsdXr-GxNMqYJlo4RCqvRFi92mpUj-IKJKhwJto0=

# Cookie used for the BFF session
SESSION_COOKIE_NAME=axiom_sid
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=43200

# ----- Frontend -----
# Target the Vite dev-server proxy uses to forward /api requests.
# Inside docker compose, the API is reachable as the service hostname "api".
VITE_API_BASE_URL=http://api:8000
